{
  "expo": {
    "name": "ResuMap",
    "slug": "hirelens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hirelens",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F0"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "in.ornalens.resumap.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6B45EA"
      },
      "versionCode": 1,
      "permissions": []
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7761261690953165~4823322506"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.2.20",
            "compileSdkVersion": 36,
            "targetSdkVersion": 36
          }
        }
      ],
      "./plugins/withKotlinMetadataSkip"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "106da4e9-de09-49b0-892d-b50ccfc014cc"
      }
    }
  }
}
