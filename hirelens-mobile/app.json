{
  "expo": {
    "name": "ResuMap — HireLens",
    "slug": "hirelens",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "hirelens",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F0"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF7F0"
      },
      "package": "in.ornalens.hirelens",
      "versionCode": 1,
      "permissions": []
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7761261690953165~4823322506"
        }
      ]
    ]
  }
}
