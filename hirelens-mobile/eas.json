{
  "cli": {
    "version": ">= 16.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://resumap-tjv1.vercel.app/api/v1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://resumap-tjv1.vercel.app/api/v1",
        "EXPO_PUBLIC_USE_REAL_ADS": "true"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  }
}
